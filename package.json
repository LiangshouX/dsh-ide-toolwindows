{
  "name": "dsh-ide-toolwindows",
  "version": "0.3.0",
  "description": "JetBrains-style tool windows for DeepSeek Harness: Project, Commit, Terminal, Git 鈥?preview tabs, git coloring, diff staging, commit graph and an embedded PTY, in one shared repository model. | DSH 鎻掍欢锛欽etBrains 寮忓伐鍏风獥鈥斺€擯roject / Commit / Terminal / Git 鍥涚獥鍏变韩鍚屼竴浠戒粨搴撶姸鎬侊紝棰勮鏍囩銆丟it 鐫€鑹层€佸樊寮傛殏瀛樸€佹彁浜ゅ浘璋变笌鍐呭祵缁堢銆?,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiangshouX/dsh-ide-toolwindows.git"
  },
  "homepage": "https://github.com/LiangshouX/dsh-ide-toolwindows#readme",
  "bugs": {
    "url": "https://github.com/LiangshouX/dsh-ide-toolwindows/issues"
  },
  "author": "LiangshouX",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/index.js",
    "src/host",
    "dist/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ide",
    "tool-windows",
    "project",
    "git",
    "terminal",
    "commit",
    "jetbrains"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
